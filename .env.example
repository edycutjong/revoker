# Revoker — environment
#
# Credentials resolve in priority order:
#   1. process.env
#   2. ~/.config/keeperhub/env     <- preferred for local dev; lives outside the repo
#   3. ./.env                      <- this file, gitignored
#
# Nothing here is ever committed. CI fails the build on any credential-shaped
# string in tracked files.
#
# Every key below resolves through that chain, including PORT and
# REVOKER_AUDIT_LOG.

# --- none of this is required to try it -------------------------------------

# Run with no account at all:
#   pnpm demo          one real scan of the public demo wallet, executes nothing
#   pnpm demo:verify   replay a recorded run at http://localhost:3000/verify
#
# REVOKER_DEMO substitutes the project's public demo wallet and a sentinel API
# key that no KeeperHub organisation will accept, and forces --dry-run on
# regardless of the flags you pass. Any real credentials you have are IGNORED
# while it is set, so demo mode cannot half-attach to your organisation.
# REVOKER_DEMO=1

# --- required for a real run ------------------------------------------------

# Organisation-scoped KeeperHub API key.
# app.keeperhub.com -> Settings -> API Keys -> Organisation
KH_API_KEY=kh_your_key_here

# The org's Turnkey wallet. app.keeperhub.com -> Wallet tab.
#
# This is necessarily BOTH the watched wallet and the revoke sender:
# approve(spender, 0) clears msg.sender's allowance, and KeeperHub signs only
# for this account. That constraint is why Revoker targets AGENT wallets —
# keeper bots, liquidation and rebalancing signers, DeFi automation — which are
# already programmatically custodied. `pnpm spike` asserts this matches the
# account KeeperHub actually controls and fails loudly if not.
KH_WALLET_ADDRESS=0xyour_turnkey_wallet

# --- network ----------------------------------------------------------------

KH_NETWORK=sepolia
KH_CHAIN_ID=11155111

# Used only to verify independently what KeeperHub reports. Never used to write.
# The `young-spender` rule needs historical state — point this at an ARCHIVE node
# to enable it. On a pruning node the rule abstains as INDETERMINATE.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- optional: demo fixtures ------------------------------------------------

# Throwaway testnet key used ONLY by `pnpm seed` / `pnpm deploy:view` to deploy
# the demo fixtures, and to PLAY THE ADVERSARY — it is the key that sends the
# drain transaction, because it is the attacker. It never signs a revoke, and it
# is the only non-KeeperHub signer anywhere in the demo path. Generate with
# `cast wallet new` and fund it with a little Sepolia ETH.
# DEPLOYER_PRIVATE_KEY=0xyour_throwaway_testnet_key

# --- optional: the workflow callback ----------------------------------------

# Shared secret for POST /revoke, the callback a KeeperHub workflow uses to
# escalate a detection into the agent's atomic check-and-execute write.
#
# AGENT-SIDE. Read by src/server.ts. Leave it UNSET and the endpoint FAILS
# CLOSED — it answers 503 and refuses every request, rather than accepting
# unauthenticated ones. In any dry-run or demo mode the route is a plain 404:
# absent rather than merely disabled.
#
# scripts/deploy-workflow.ts reads the SAME variable to substitute into the
# workflow definition, so the two sides must hold an identical value. Check
# GET /api/meta reports revokeCallback "armed" before enabling the workflow.
# REVOKER_CALLBACK_SECRET=generate_a_long_random_string

# Where the workflow should POST. Must be reachable from KeeperHub, so a public
# URL or a tunnel — not localhost.
# REVOKER_CALLBACK_URL=https://your-agent.example.com/revoke

# What the workflow trigger watches. Both default from deployments.json and
# KH_WALLET_ADDRESS, so you only set these to point at something else.
# REVOKER_WATCHED_TOKEN=0x...
# REVOKER_WATCHED_WALLET=0x...

# --- optional: runtime ------------------------------------------------------

# Where the /verify dashboard listens. Read through config.ts like everything
# else, so setting it here or in ~/.config/keeperhub/env both work.
# PORT=3000

# Audit trail location. config.ts publishes the resolved value into the
# environment on load, which is how audit.ts stays dependency-free and this key
# still honours the chain above.
# REVOKER_AUDIT_LOG=audit/revoker.jsonl

# Path to the `kh` binary, if it is not on PATH. `pnpm seed` arms the approval
# through the real CLI when it is available and falls back to REST when it is
# not, so this is never required.
# KH_BIN=kh
