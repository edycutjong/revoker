{
  "name": "revoker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous approval-drainer sentinel that lands approve(spender,0) through KeeperHub before the drain completes.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike": "tsx scripts/spike.ts",
    "seed": "tsx scripts/seed.ts",
    "watch": "tsx src/index.ts",
    "bench": "tsx scripts/bench.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "vitest run --coverage",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm contracts:test",
    "contracts:coverage": "cd contracts && forge coverage --report summary"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "viem": "^2.21.55"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0"
    }
  }
}
